{
  "name": "@sessiondeck/hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@sessiondeck/contract": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.0.0",
    "ws": "^8.18.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/ws": "^8.5.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "node scripts/bundle.mjs src/main.ts dist/main.mjs && node dist/main.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "ws:harness": "node scripts/ws-harness.mjs",
    "bundle": "node scripts/bundle.mjs src/main.ts dist/main.mjs",
    "gen:golden": "node scripts/bundle.mjs scripts/gen-golden.ts dist/gen-golden.mjs && node dist/gen-golden.mjs"
  }
}
