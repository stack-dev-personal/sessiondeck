# Copy to infra/.env and chmod 600. infra/.env is gitignored. Placeholder values only.
# Generate a token:  openssl rand -base64 32

# Required. Bearer token the probe daemon and the web UI present to the hub. At least 16 characters.
HUB_TOKEN=replace-with-a-long-random-token

# Host interface the ports publish on. Loopback is the default. LAN exposure is an explicit choice:
# set to the laptop's LAN address (or 0.0.0.0) only on a network you trust.
#HUB_BIND=127.0.0.1
#WEB_BIND=127.0.0.1
#HUB_PORT=8787
#WEB_PORT=5173

# Browser origins allowed to open the WebSocket stream; recommended whenever a bind is not loopback.
#HUB_ALLOWED_ORIGINS=http://localhost:5173
