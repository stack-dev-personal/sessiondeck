# sessiondeck laptop stack. Copy to infra/.env and chmod 600 infra/.env. Never commit infra/.env.
# HUB_TOKEN is deliberately empty: the hub refuses to start until you set a random token of at least
# 16 characters (for example: openssl rand -hex 24).
HUB_TOKEN=

# Optional hub tuning (read by the hub inside the container). HUB_PORT, HUB_BIND and HUB_DB_PATH are
# pinned by docker-compose.yml and ignored here.
# HUB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HUB_TIMEZONE=Europe/Berlin

# Compose-only settings (the hub never reads these). A value exported in your shell wins over this file.
# Host interface and port for each published service. Default is loopback; 0.0.0.0 exposes it on the LAN
# and Docker-published ports bypass ufw/firewalld, so set HUB_ALLOWED_ORIGINS as well.
# SD_HUB_PUBLISH_IP=127.0.0.1
# SD_HUB_PUBLISH_PORT=8787
# SD_WEB_PUBLISH_IP=127.0.0.1
# SD_WEB_PUBLISH_PORT=5173
# Hub origins the web page may connect to (CSP connect-src), space separated, http and ws forms.
# SD_WEB_CONNECT_SRC=http://localhost:8787 ws://localhost:8787 http://127.0.0.1:8787 ws://127.0.0.1:8787
