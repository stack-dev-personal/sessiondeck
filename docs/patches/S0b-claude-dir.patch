+// capture-install --apply: node, node.exe or npx at the start of a command (or after && ; | $( a
+// backtick, a quote, or cmd /c, -c, -Command), the capture-install script as its first non-option
+// argument, and a standalone --apply flag in the same command, before or after the script. The flag
+// must be followed by whitespace, a quote, a closer or the end, so --apply-later and mentions in
+// grep, git log or a commit message (no node in front) are not matched. \x5c is a backslash.
+const SEP = String.raw`(?:\s|\x5c\r?\n)+`;
+const NODE = String.raw`(?:^|[;&|\n(\`"']|\s(?:/c|-c|-command)\s)\s*(?:[^\s|;&"'()\`]*[\x5c/])?(?:node(?:\.exe)?|npx(?:\.cmd)?)`;
+const FLAG = String.raw`(?:^|[\s"'=])--apply(?=[\s"'\`);&|\x5c]|$)`;
+const SEGMENT = String.raw`(?:[^|;&\n]|\x5c\r?\n)*?`;
+const OPTION = String.raw`(?:${SEP}--?[\w.-]+(?:=[^\s|;&]+)?)`;
+const SCRIPT = String.raw`["']?(?:[^\s|;&"']*[\x5c/])?capture-install(?:\.mjs)?(?=[\s"'\`);&|\x5c]|$)`;
+const CAPTURE_APPLY = new RegExp(`${NODE}(?=${SEGMENT}${FLAG})${OPTION}*${SEP}${SCRIPT}`, 'i');
+
 const RULES = [
   { re: /\bgit\s+push\b[^|;&]*\s(--force|-f|--force-with-lease)\b/, why: 'force push is forbidden' },
